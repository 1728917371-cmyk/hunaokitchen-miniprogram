.home-page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f1df 0%, #f3e2c4 55%, #ffe2bc 100%);
}

.kitchen-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bg-shade {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background: linear-gradient(180deg, rgba(181, 106, 46, 0.16) 0%, rgba(255, 159, 67, 0.14) 100%);
}

.home-content {
  position: relative;
  z-index: 1;
}

.home-glass {
  background: rgba(255, 255, 255, 0.62);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 2rpx solid rgba(240, 211, 168, 0.72);
  box-shadow: 8rpx 8rpx 0 rgba(181, 106, 46, 0.14);
}

.hero {
  margin-top: 20rpx;
  text-align: center;
}

.hero-emoji {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

/* 主视觉透明动物放大展示 */
.featured-stage {
  position: relative;
  width: 360rpx;
  height: 360rpx;
  margin: 4rpx auto 14rpx;
}

.featured-halo {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  right: 14rpx;
  bottom: 14rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, #fff3dc 0%, #fbe8cb 56%, rgba(251, 232, 203, 0) 100%);
}

.featured-img {
  position: relative;
  width: 332rpx;
  height: 332rpx;
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 18rpx;
  background: rgba(251, 232, 203, 0.86);
  color: #b56a2e;
  border: 1rpx solid #f3e3c6;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.hero-title {
  margin-bottom: 20rpx;
}

.hero-desc {
  margin-bottom: 28rpx;
}

.char-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 28rpx;
}

.char-row {
  display: inline-flex;
  gap: 18rpx;
  padding: 4rpx 4rpx 12rpx;
}

.char-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 172rpx;
}

.char-thumb {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, #fff3dc 0%, #fbe8cb 58%, rgba(251, 232, 203, 0) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.char-img {
  width: 144rpx;
  height: 144rpx;
}

.hero-deco {
  margin: 4rpx 0 24rpx;
  font-size: 34rpx;
  letter-spacing: 14rpx;
}

.hero-deco text {
  display: inline-block;
}

.char-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #6b4a2e;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.char-code {
  font-size: 18rpx;
  color: #b56a2e;
  letter-spacing: 1rpx;
}

.intro-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.intro-item {
  background: rgba(251, 232, 203, 0.60);
  border: 1rpx solid rgba(243, 227, 198, 0.55);
  border-radius: 24rpx;
  padding: 22rpx;
  text-align: center;
}

.intro-letter {
  font-size: 30rpx;
  font-weight: 800;
  color: #b56a2e;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.intro-name {
  font-size: 24rpx;
  color: #8a6640;
  margin-bottom: 8rpx;
}

.intro-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #5c3e24;
  line-height: 1.5;
}

.start-btn {
  margin-top: 8rpx;
}

.history-btn {
  margin-top: 20rpx;
}

.tips {
  margin-top: 24rpx;
}

.tip-line {
  font-size: 26rpx;
  color: #6b4a2e;
  line-height: 1.7;
}
