.result-page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f1df 0%, #f3e2c4 55%, #ffe2bc 100%);
}

.kitchen-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bg-shade {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background: linear-gradient(180deg, rgba(181, 106, 46, 0.16) 0%, rgba(255, 159, 67, 0.14) 100%);
}

.result-content {
  position: relative;
  z-index: 1;
}

/* ===== 高透明卡通玻璃/贴纸卡 ===== */
.glass-card {
  background: rgba(255, 255, 255, 0.58);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(240, 211, 168, 0.68);
  box-shadow: 8rpx 8rpx 0 rgba(181, 106, 46, 0.12);
}

/* ===== 顶部人格玻璃卡 ===== */
.hero-glass {
  margin-top: 12rpx;
  border-radius: 36rpx;
  padding: 28rpx 24rpx 22rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.56);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 2rpx solid rgba(240, 211, 168, 0.72);
  box-shadow: 8rpx 8rpx 0 rgba(181, 106, 46, 0.14);
}

.result-badge {
  display: inline-block;
  padding: 10rpx 20rpx;
  background: rgba(251, 232, 203, 0.88);
  color: #b56a2e;
  border: 1rpx solid #f3e3c6;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.result-code {
  font-size: 60rpx;
  font-weight: 800;
  color: #b56a2e;
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.result-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #5c3e24;
  margin-bottom: 8rpx;
}

.result-en {
  font-size: 22rpx;
  color: #a98a63;
}

/* 放大主角动物形象 */
.hero-char-frame {
  position: relative;
  width: 400rpx;
  height: 400rpx;
  margin: 8rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.char-halo {
  position: absolute;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, #fff3dc 0%, #fbe8cb 58%, rgba(251, 232, 203, 0) 100%);
}

.hero-img {
  position: relative;
  width: 370rpx;
  height: 370rpx;
}

.hero-animal {
  margin: 12rpx 6rpx 0;
  background: rgba(251, 232, 203, 0.62);
  border: 1rpx solid rgba(243, 227, 198, 0.6);
  border-radius: 24rpx;
  padding: 18rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a5a32;
  line-height: 1.6;
}

/* ===== 评语 + 拿手菜 ===== */
.quote-card {
  margin-top: 24rpx;
  position: relative;
}

.card-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.card-emoji {
  font-size: 30rpx;
}

.card-head-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #b56a2e;
}

.quote-mark {
  position: absolute;
  left: 26rpx;
  top: 62rpx;
  font-size: 84rpx;
  color: #f0d3a8;
  font-family: georgia, serif;
  line-height: 1;
}

.paragraph {
  position: relative;
  padding-left: 40rpx;
  font-size: 28rpx;
  line-height: 1.9;
  color: #6b4a2e;
}

.recipe-strip {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(251, 232, 203, 0.64);
  border: 1rpx solid rgba(243, 227, 198, 0.55);
  border-radius: 24rpx;
  padding: 18rpx 22rpx;
}

.recipe-emoji {
  font-size: 30rpx;
}

.recipe-text {
  font-size: 26rpx;
  color: #8a5a32;
  font-weight: 600;
  line-height: 1.5;
}

/* ===== 标签胶囊 ===== */
.tag-board {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.big-tag {
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, 0.58);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  border: 1rpx solid rgba(240, 211, 168, 0.66);
  color: #b56a2e;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 999rpx;
}

/* ===== 四维基因瓦片 ===== */
.dim-card {
  margin-top: 24rpx;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.dim-tile {
  background: rgba(251, 232, 203, 0.62);
  border: 1rpx solid rgba(243, 227, 198, 0.55);
  border-radius: 28rpx;
  padding: 22rpx;
  text-align: center;
}

.dim-key-badge {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f0a35c, #d97634);
  color: #fff8ec;
  font-size: 30rpx;
  font-weight: 800;
}

.dim-name {
  font-size: 24rpx;
  color: #8a6640;
  margin-bottom: 8rpx;
}

.dim-score {
  font-size: 22rpx;
  color: #a98a63;
  margin-bottom: 12rpx;
}

.dim-bar {
  width: 100%;
  height: 14rpx;
  background: rgba(241, 227, 200, 0.86);
  border-radius: 999rpx;
  overflow: hidden;
}

.dim-left {
  height: 100%;
  background: linear-gradient(90deg, #f0a35c, #d97634);
  border-radius: 999rpx;
}

/* ===== 关系图透明头像卡 ===== */
.relation-board {
  margin-top: 24rpx;
}

.relation-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #b56a2e;
  margin-bottom: 18rpx;
}

.relation-row {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
}

.relation-card {
  flex: 1;
  border-radius: 28rpx;
  padding: 22rpx 16rpx;
  text-align: center;
}

.rel-img {
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto 14rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, #fff3dc 0%, #fbe8cb 62%, rgba(251, 232, 203, 0) 100%);
}

.rel-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.rel-tag--good {
  background: rgba(251, 232, 203, 0.82);
  color: #b56a2e;
}

.rel-tag--cold {
  background: rgba(255, 226, 188, 0.78);
  color: #b56a2e;
}

.rel-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #5c3e24;
  margin-bottom: 6rpx;
  line-height: 1.4;
}

.rel-code {
  font-size: 22rpx;
  color: #a98a63;
  letter-spacing: 2rpx;
}

.rel-link {
  align-self: center;
  font-size: 36rpx;
  color: #ff9f43;
}

/* ===== 海报卡与操作 ===== */
.poster-card {
  margin-top: 24rpx;
}

.poster-sub {
  font-size: 24rpx;
  color: #8a6640;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.poster-btns {
  display: flex;
  gap: 20rpx;
}

.poster-btn {
  flex: 1;
  font-size: 28rpx;
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 375px;
  height: 625px;
}

.action-col {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 28rpx 0 36rpx;
}

.mt16 {
  margin-top: 0;
}

.empty-card {
  margin-top: 120rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #b56a2e;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8a6640;
  line-height: 1.7;
  margin-bottom: 32rpx;
}
