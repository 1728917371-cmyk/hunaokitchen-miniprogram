.quiz-page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f1df 0%, #f3e2c4 55%, #ffe2bc 100%);
}

.kitchen-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bg-shade {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background: linear-gradient(180deg, rgba(181, 106, 46, 0.18) 0%, rgba(255, 159, 67, 0.12) 100%);
}

.quiz-content {
  position: relative;
  z-index: 1;
}

.quiz-glass {
  background: rgba(255, 255, 255, 0.64);
  backdrop-filter: blur(14rpx);
  -webkit-backdrop-filter: blur(14rpx);
  border: 2rpx solid rgba(240, 211, 168, 0.72);
  box-shadow: 8rpx 8rpx 0 rgba(181, 106, 46, 0.14);
}

.progress-card {
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.progress-top {
  margin-bottom: 16rpx;
  align-items: center;
}

.progress-side {
  font-size: 24rpx;
  color: #6b4a2e;
  font-weight: 700;
}

.progress-bar {
  width: 100%;
  height: 14rpx;
  background: rgba(241, 227, 200, 0.86);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #f0a35c, #d97634);
  border-radius: 999rpx;
  transition: width 0.2s ease;
}

.question-card {
  min-height: 720rpx;
}

.part {
  display: inline-block;
  padding: 10rpx 18rpx;
  background: rgba(251, 232, 203, 0.86);
  border: 1rpx solid #f3e3c6;
  border-radius: 999rpx;
  color: #b56a2e;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.question-title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.6;
  margin-bottom: 28rpx;
  color: #5c3e24;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 28rpx 26rpx;
  border-radius: 26rpx;
  background: rgba(255, 243, 220, 0.62);
  border: 1rpx solid rgba(243, 227, 198, 0.55);
}

.option--active {
  background: rgba(251, 232, 203, 0.92);
  border-color: #f0a35c;
}

.option-key {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  color: #b56a2e;
  font-weight: 800;
  font-size: 24rpx;
  flex-shrink: 0;
}

.option-text {
  font-size: 28rpx;
  color: #6b4a2e;
  line-height: 1.8;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
}
