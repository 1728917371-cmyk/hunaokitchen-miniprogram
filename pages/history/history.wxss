.stats-card {
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 20rpx;
}

.stat-item {
  background: #fbe8cb;
  border-radius: 24rpx;
  padding: 24rpx;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #b56a2e;
  line-height: 1.3;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.stat-label {
  font-size: 22rpx;
  color: #a98a63;
  line-height: 1.5;
}

.section-head {
  margin-bottom: 12rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: #b56a2e;
  padding: 8rpx 4rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-top: 2rpx solid #f1e3c8;
}

.history-item:first-of-type {
  border-top: none;
}

.history-code {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 28rpx;
  background: #fbe8cb;
  color: #b56a2e;
  font-weight: 800;
  font-size: 30rpx;
  flex-shrink: 0;
}

.history-body {
  flex: 1;
  min-width: 0;
}

.history-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #5c3e24;
  margin-bottom: 6rpx;
}

.history-animal {
  font-size: 24rpx;
  color: #8a6640;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-time {
  font-size: 22rpx;
  color: #a98a63;
  margin-top: 8rpx;
}

.history-arrow {
  font-size: 48rpx;
  color: #d9a86f;
  flex-shrink: 0;
}

.empty-card {
  margin-top: 120rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #5c3e24;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8a6640;
  line-height: 1.7;
  margin-bottom: 32rpx;
}

.foot-btn {
  margin: 28rpx 0 36rpx;
}

.history-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, #fff3dc 0%, #fbe8cb 62%, rgba(251, 232, 203, 0) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.history-avatar {
  width: 100rpx;
  height: 100rpx;
}
